{
  "manifest_version": 3,
  "name": "CleanShare",
  "short_name": "CleanShare",
  "version": "1.1.0",
  "description": "Strips account-bound share tags from links you copy or share on YouTube, X, Facebook and Instagram.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cleanshare@konscanner.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "scripts": [
      "background/service-worker.js"
    ]
  },
  "action": {
    "default_title": "CleanShare",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "src/cleaner.js",
        "src/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
